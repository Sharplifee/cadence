<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The CFBundle* keys below are not optional. Without CFBundleIdentifier the
       archive step fails with the unhelpful "Archive Missing Bundle Identifier"
       long after the build itself has succeeded. -->
  <key>CFBundleDevelopmentRegion</key>
  <string>$(DEVELOPMENT_LANGUAGE)</string>
  <key>CFBundleExecutable</key>
  <string>$(EXECUTABLE_NAME)</string>
  <key>CFBundleIdentifier</key>
  <string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>CFBundleName</key>
  <string>$(PRODUCT_NAME)</string>
  <key>CFBundleDisplayName</key>
  <string>Cadence</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleShortVersionString</key>
  <string>0.1.0</string>
  <key>CFBundleVersion</key>
  <string>$(CURRENT_PROJECT_VERSION)</string>
  <key>CFBundleIconName</key>
  <string>AppIcon</string>
  <key>LSRequiresIPhoneOS</key>
  <true/>
  <key>UILaunchScreen</key>
  <dict/>
  <key>UISupportedInterfaceOrientations</key>
  <array><string>UIInterfaceOrientationPortrait</string></array>

  <key>NSMicrophoneUsageDescription</key>
  <string>Cadence listens to your conversations on-device to coach your pace, volume and turn-taking. Audio never leaves this phone.</string>
  <key>NSSpeechRecognitionUsageDescription</key>
  <string>Self Attune transcribes your conversations entirely on this phone so you can read back how you actually spoke. Nothing is uploaded.</string>
  <key>NSHealthShareUsageDescription</key>
  <string>Cadence starts a brief mindfulness session so it can wake the watch app for you, instead of making you open it by hand.</string>
  <key>NSHealthUpdateUsageDescription</key>
  <string>Cadence starts a brief mindfulness session so it can wake the watch app for you, instead of making you open it by hand.</string>
  <key>UIBackgroundModes</key>
  <array><string>audio</string></array>

  <key>CADENCE_API_URL</key>
  <string>$(CADENCE_API_URL)</string>
  <key>CADENCE_API_KEY</key>
  <string>$(CADENCE_API_KEY)</string>
</dict>
</plist>
